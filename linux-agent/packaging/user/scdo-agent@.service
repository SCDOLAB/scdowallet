[Unit]
Description=SCDO bookkeeping agent (%i)
Documentation=https://scdo.com.au/agent-ledger/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/scdo-agent --data-dir %h/.local/share/scdo-agent run --name %i
Environment=SCDO_AGENT_MODE=user
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=default.target
