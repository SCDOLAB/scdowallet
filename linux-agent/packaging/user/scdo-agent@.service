[Unit]
Description=SCDO bookkeeping agent (%i)
Documentation=https://scdo.com.au/agent-ledger/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/scdo-agent --data-dir %h/.local/share/scdo-agent run --name %i
Environment=SCDO_AGENT_MODE=user
Restart=on-failure
RestartSec=10
# A user manager cannot apply sandbox options that need a user namespace or
# capabilities. Ubuntu sets kernel.apparmor_restrict_unprivileged_userns=1,
# and those options then fail the unit with status=218/CAPABILITIES.
# Kept off here: PrivateTmp, ProtectSystem, ProtectKernelTunables,
# ProtectKernelModules, ProtectControlGroups. The system unit still sets them.
NoNewPrivileges=true
LockPersonality=true

[Install]
WantedBy=default.target
